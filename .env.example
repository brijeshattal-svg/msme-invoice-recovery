GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODELS=
# "paid" once billing is enabled on the Gemini key; anything else = free tier (shown on /privacy).
GEMINI_BILLING=
# Optional accounts (saved invoice lists). Both from Supabase: Project Settings > API.
# The anon/publishable key is browser-safe (row-level security limits it). NEVER put the
# service_role key here or in any NEXT_PUBLIC_ variable. Leave empty to run without accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
